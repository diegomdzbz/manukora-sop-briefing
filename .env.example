# Copy to .env and fill in. Never commit .env.
#
# Only needed for the LLM narrative layer. The engine, the tests and the
# --no-llm briefing all run without it.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. If unset, the n8n workflow writes the briefing to disk instead of
# posting it. See RUNBOOK.md.
SLACK_WEBHOOK_URL=
