# Copy to .env and fill in. Never commit .env.
#
# Only the narrative layer needs a key. The engine, the tests and the `--no-llm`
# briefing all run without one.
#
# Whichever key is present is used, Anthropic first. See src/providers.py.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. If unset, the n8n workflow writes the briefing to disk instead of
# posting it. See RUNBOOK.md.
SLACK_WEBHOOK_URL=
