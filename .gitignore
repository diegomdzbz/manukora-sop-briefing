# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# n8n local state (may contain credentials)
n8n/.n8n/
n8n_data/

# Local agent state and worktrees. Holds a full checkout of this repo, so an
# unguarded `git add -A` would otherwise commit a nested copy of the project.
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini
