{
  "name": "Manukora — Monthly S&OP Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "triggerAtDayOfMonth": 1,
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Monthly on the 1st",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-460, 300],
      "notes": "07:00 NZ on the first of the month, after the previous month has closed."
    },
    {
      "parameters": {
        "url": "http://engine:8000/facts",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Get fact pack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 220],
      "notes": "The engine container. n8n has no Python interpreter and cannot see the repo on the host, so the two services talk over HTTP. Every number in the briefing originates behind this endpoint."
    },
    {
      "parameters": {
        "url": "http://engine:8000/prompt",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Get prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 400],
      "notes": "Fetched rather than pasted into the node. The prompt lives in prompts/v2_final.md and is served by the engine, so the workflow and the CLI cannot drift onto different instructions."
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Merge facts and prompt",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [0, 300]
    },
    {
      "parameters": {
        "model": "claude-opus-5",
        "options": {
          "maxTokensToSample": 16000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [300, 480],
      "notes": "Credentials are configured in n8n, never in this file. ANTHROPIC_API_KEY is passed to the container from the host environment."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Here is the fact pack for this month's review. Write the briefing.\n\n```json\n{{ JSON.stringify($json, null, 2) }}\n```",
        "options": {
          "systemMessage": "={{ $json.system }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Write the briefing",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [240, 300],
      "notes": "The agent writes prose only. Every figure is computed upstream by the engine and rendered from the fact pack — the model is not asked to calculate anything."
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "output",
        "options": {
          "fileName": "sop_briefing.md"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "To markdown file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [560, 300]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/data/output/sop_briefing_latest.md",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Save to disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [780, 220],
      "notes": "Mounted to ./output on the host. This is the delivery that is demonstrated in the screenshot."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.output }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 400],
      "disabled": true,
      "notes": "DISABLED ON PURPOSE. No Slack workspace was available for this exercise, so this node is wired and left off rather than faked. Set SLACK_WEBHOOK_URL and enable it to switch delivery on — nothing else changes."
    }
  ],
  "connections": {
    "Monthly on the 1st": {
      "main": [
        [
          { "node": "Get fact pack", "type": "main", "index": 0 },
          { "node": "Get prompt", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get fact pack": {
      "main": [[{ "node": "Merge facts and prompt", "type": "main", "index": 0 }]]
    },
    "Get prompt": {
      "main": [[{ "node": "Merge facts and prompt", "type": "main", "index": 1 }]]
    },
    "Merge facts and prompt": {
      "main": [[{ "node": "Write the briefing", "type": "main", "index": 0 }]]
    },
    "Claude": {
      "ai_languageModel": [
        [{ "node": "Write the briefing", "type": "ai_languageModel", "index": 0 }]
      ]
    },
    "Write the briefing": {
      "main": [[{ "node": "To markdown file", "type": "main", "index": 0 }]]
    },
    "To markdown file": {
      "main": [
        [
          { "node": "Save to disk", "type": "main", "index": 0 },
          { "node": "Post to Slack", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "manukora-sop-briefing"
  },
  "tags": []
}
